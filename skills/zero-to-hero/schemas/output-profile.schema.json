{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.com/schemas/zero-to-hero/output-profile.schema.json",
  "title": "zero-to-hero output profile",
  "description": "Executable contract for selecting and composing one zero-to-hero output profile. Artifact paths are repository-relative exact paths. During composition, a path required by any selected profile supersedes another selected profile's standalone forbidden assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "detect",
    "approved",
    "composition",
    "artifacts",
    "evidence_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/profile_id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities_any",
        "capabilities_all"
      ],
      "properties": {
        "capabilities_any": {
          "$ref": "#/$defs/capability_list"
        },
        "capabilities_all": {
          "$ref": "#/$defs/capability_list"
        }
      }
    },
    "approved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities_any"
      ],
      "properties": {
        "capabilities_any": {
          "$ref": "#/$defs/nonempty_capability_list"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible_with",
        "default_profiles"
      ],
      "properties": {
        "compatible_with": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile_id"
          },
          "uniqueItems": true
        },
        "default_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile_id"
          },
          "uniqueItems": true
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional",
        "forbidden"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_path"
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_path"
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_path"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_requirement"
      }
    }
  },
  "$defs": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "capability_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "uniqueItems": true
    },
    "nonempty_capability_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      },
      "uniqueItems": true
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "artifacts_any",
        "checks_all"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "artifacts_any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_path"
          },
          "uniqueItems": true
        },
        "checks_all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
